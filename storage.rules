rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      // Escritura solo para el super admin (gestión de imágenes de catálogo)
      // Requiere que exista /superAdmin/{uid} en Firestore, igual que en firestore.rules
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/superAdmin/$(request.auth.uid));
    }
  }
}